---
import { SITE_TITLE, SOCIAL_LINKS } from '../../lib/constants';
---

<footer class="border-t border-white/[0.04] py-16 px-6">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-[10px] text-warm-500/25 tracking-[0.3em] uppercase font-mono">
      © 2026 {SITE_TITLE}
    </div>
    <div class="flex items-center gap-8">
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[10px] text-warm-500/30 hover:text-primary transition-colors tracking-[0.2em] uppercase font-mono"
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</footer>
