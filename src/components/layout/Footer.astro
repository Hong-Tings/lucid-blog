---
import { SITE_TITLE, SOCIAL_LINKS } from '../../lib/constants';
---

<footer class="py-16 px-6 transition-colors duration-500">
  <div class="max-w-7xl mx-auto glass-card px-8 py-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-[10px] text-warm-400 tracking-[0.3em] uppercase font-mono">
      © 2026 {SITE_TITLE}
    </div>
    <div class="flex items-center gap-8">
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="link-draw text-[10px] text-warm-400 hover:text-white transition-colors tracking-[0.2em] uppercase font-mono"
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</footer>
