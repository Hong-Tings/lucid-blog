---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SmoothScroll from '../components/effects/SmoothScroll';
import FloatingShapes from '../components/effects/FloatingShapes';
import ScrollProgress from '../components/effects/ScrollProgress';
import Preloader from '../components/effects/Preloader.astro';
import NowPlaying from '../components/sections/NowPlaying';
import CommandPalette from '../components/effects/CommandPalette';
import BackToTop from '../components/effects/BackToTop';
import CursorSpotlight from '../components/effects/CursorSpotlight';
import FluidBackground from '../components/effects/FluidBackground';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  showPreloader?: boolean;
  showFluid?: boolean;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, showPreloader = false, showFluid = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <ViewTransitions />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        if (stored === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class:list={[{ 'dark': showFluid }, 'relative dark:text-warm-200 transition-colors duration-500']}>
    {showFluid && <FluidBackground client:load delaySplash={showPreloader} />}
    {showPreloader && <Preloader />}

    <!-- Scroll Progress Bar -->
    <ScrollProgress client:load />

    <!-- Floating geometric shapes -->
    <FloatingShapes client:load />

    <SmoothScroll client:load>
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </SmoothScroll>

    <NowPlaying client:load />

    <!-- Command Palette (Cmd+K) -->
    <CommandPalette client:load />

    <!-- Back to top button -->
    <BackToTop client:load />

    <!-- Cursor spotlight (dark mode only) -->
    <CursorSpotlight client:load />

    {/* Preloader logic: is:inline so it persists across View Transitions.
        astro:page-load fires on initial load AND after every navigation swap. */}
    <script is:inline>
      document.addEventListener('astro:page-load', function() {
        var el = document.getElementById('preloader');
        if (!el) {
          window.dispatchEvent(new CustomEvent('preloader-done'));
          return;
        }

        // Already played this session — skip immediately
        if (sessionStorage.getItem('lucid-preloader-done')) {
          el.style.display = 'none';
          window.dispatchEvent(new CustomEvent('preloader-done'));
          return;
        }

        // Play preloader animation — 2.5s total
        setTimeout(function() {
          el.classList.add('reveal');
          setTimeout(function() {
            el.style.display = 'none';
            sessionStorage.setItem('lucid-preloader-done', '1');
            window.dispatchEvent(new CustomEvent('preloader-done'));
          }, 1200);
        }, 2500);
      });
    </script>
  </body>
</html>
