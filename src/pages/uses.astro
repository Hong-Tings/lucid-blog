---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBackground from '../components/effects/PageBackground.astro';

const categories = [
  {
    name: '开发',
    icon: '⌨️',
    items: [
      { name: '编辑器', value: 'Neovim + VSCode' },
      { name: '终端', value: 'Warp + tmux' },
      { name: '浏览器', value: 'Arc' },
      { name: '版本控制', value: 'Git + GitHub' },
      { name: '包管理', value: 'pnpm' },
      { name: '部署', value: 'Vercel + Docker' },
    ],
  },
  {
    name: '设计',
    icon: '🎨',
    items: [
      { name: 'UI 设计', value: 'Figma' },
      { name: '图片编辑', value: 'Photoshop + Lightroom' },
      { name: '原型工具', value: 'Framer' },
      { name: '配色', value: 'Coolors + Realtime Colors' },
    ],
  },
  {
    name: '硬件',
    icon: '💻',
    items: [
      { name: '电脑', value: 'MacBook Pro M3' },
      { name: '显示器', value: 'LG 27UK850' },
      { name: '键盘', value: 'HHKB Professional Hybrid' },
      { name: '鼠标', value: 'Logitech MX Master 3S' },
      { name: '耳机', value: 'AirPods Pro + Sony WH-1000XM5' },
      { name: '相机', value: 'Fujifilm X-T5' },
    ],
  },
  {
    name: '软件',
    icon: '📱',
    items: [
      { name: '笔记', value: 'Obsidian' },
      { name: '任务管理', value: 'Things 3' },
      { name: '阅读', value: '微信读书 + Kindle' },
      { name: '音乐', value: 'Apple Music + Spotify' },
      { name: '播客', value: 'Overcast' },
      { name: '密码管理', value: '1Password' },
    ],
  },
  {
    name: '网站',
    icon: '🌐',
    items: [
      { name: '博客框架', value: 'Astro' },
      { name: '样式', value: 'Tailwind CSS' },
      { name: '动画', value: 'GSAP + Framer Motion' },
      { name: '3D', value: 'Three.js' },
      { name: '字体', value: 'Instrument Serif + Outfit + JetBrains Mono' },
      { name: '图标', value: 'Lucide' },
    ],
  },
];
---

<BaseLayout title="Uses — Lucid">
  <PageBackground theme="wave" />
  <div class="pt-28 pb-16 px-6 md:px-12 lg:px-24 relative overflow-hidden">
    {/* Oversized decorative text */}
    <div class="absolute -right-8 top-12 text-[220px] font-display italic text-warm-100 dark:text-warm-800/20 leading-none select-none pointer-events-none" aria-hidden="true">U</div>

    <div class="max-w-3xl mx-auto relative">
      <div class="flex items-center gap-4 mb-3">
        <h1 class="text-2xl font-display italic text-warm-800 dark:text-warm-200 tracking-tight glitch-hover" data-text="Uses">Uses</h1>
        <div class="flex-1 h-px bg-gradient-to-r from-primary/20 dark:from-white/20 to-transparent"></div>
      </div>
      <p class="text-xs text-warm-400 dark:text-warm-500 mb-12 tracking-wider font-mono">我使用的工具和设备</p>

      <div class="space-y-8">
        {categories.map((cat) => (
          <div class="glass-card p-6 md:p-8">
            <div class="flex items-center gap-3 mb-5">
              <span class="text-xl">{cat.icon}</span>
              <h2 class="text-sm font-display italic text-warm-800 dark:text-warm-200 tracking-tight">{cat.name}</h2>
              <div class="flex-1 h-px bg-warm-100 dark:bg-warm-800" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
              {cat.items.map((item) => (
                <div class="flex items-baseline gap-3 group">
                  <span class="text-xs text-warm-400 dark:text-warm-500 font-mono tracking-wider flex-shrink-0 w-20">{item.name}</span>
                  <span class="text-sm text-warm-600 dark:text-warm-400 group-hover:text-warm-800 dark:group-hover:text-warm-200 transition-colors">{item.value}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      {/* Footer note */}
      <div class="mt-12 text-center">
        <p class="text-[10px] text-warm-300 dark:text-warm-600 font-mono tracking-wider">
          最后更新于 2026 年 5 月 · 灵感来自 <a href="https://uses.tech" target="_blank" rel="noopener noreferrer" class="link-draw hover:text-warm-500 dark:hover:text-warm-400 transition-colors">uses.tech</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
