---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard';
import CategoryFilter from '../../components/blog/CategoryFilter';
import PageBackground from '../../components/effects/PageBackground.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Collect all tags with counts
const tagMap = new Map<string, number>();
posts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  });
});
const topTags = Array.from(tagMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);
---

<BaseLayout title="文章 — Lucid">
  <PageBackground theme="ink" />
  <div class="pt-28 pb-16 px-6 md:px-12 lg:px-24 relative overflow-hidden">
    {/* Large decorative letter */}
    <div class="absolute -right-6 top-6 text-[240px] font-display italic text-warm-100 dark:text-warm-800/20 leading-none select-none pointer-events-none" aria-hidden="true">B</div>

    <div class="max-w-3xl mx-auto relative">
      <div class="flex items-center gap-4 mb-3">
        <h1 class="text-2xl font-display italic text-warm-800 dark:text-warm-200 tracking-tight glitch-hover" data-text="文章">文章</h1>
        <div class="flex-1 h-px bg-gradient-to-r from-primary/20 dark:from-white/20 to-transparent"></div>
      </div>
      <p class="text-xs text-warm-400 dark:text-warm-500 mb-6 tracking-wider font-mono">记录技术、生活与思考</p>

      {/* Top tags */}
      {topTags.length > 0 && (
        <div class="flex items-center gap-2 mb-8 flex-wrap">
          <span class="text-[10px] text-warm-300 dark:text-warm-600 font-mono tracking-wider mr-1">标签</span>
          {topTags.map(([tag, count]) => (
            <a href={`${import.meta.env.BASE_URL}tags/${tag}`} class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-mono tracking-wider border border-warm-200 dark:border-warm-700 text-warm-500 dark:text-warm-400 hover:border-warm-400 dark:hover:border-warm-500 hover:text-warm-700 dark:hover:text-warm-300 transition-all duration-200">
              #{tag}
              <span class="text-warm-300 dark:text-warm-600">{count}</span>
            </a>
          ))}
          <a href={`${import.meta.env.BASE_URL}tags`} class="text-[10px] font-mono tracking-wider text-warm-300 dark:text-warm-600 hover:text-warm-500 dark:hover:text-warm-400 transition-colors ml-1">全部 →</a>
        </div>
      )}

      <CategoryFilter client:load onFilterChange={() => {}} />

      <div class="glass-card p-6 md:p-8">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            category={post.data.category}
            slug={post.slug}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
