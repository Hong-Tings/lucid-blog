---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard';
import CategoryFilter from '../../components/blog/CategoryFilter';
import { NumberTicker } from '../../components/magic-ui/NumberTicker';
import { BlurFade } from '../../components/magic-ui/BlurFade';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/utils';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = posts[0];
const rest = posts.slice(1);       // all remaining posts
const postCount = posts.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="文章 — Lucid">

  {/* Background: floating writing-themed objects with parallax */}
  <div class="bg-objects" aria-hidden="true" id="bg-objects">
    <svg class="bg-obj bg-obj-1" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.12">
        <path d="M85 25L40 70L30 80L28 92L40 90L50 80L95 35L85 25Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M70 40L80 50" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M40 70L50 80" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 3"/>
        <circle cx="28" cy="92" r="3" fill="currentColor" opacity="0.4"/>
      </g>
    </svg>
    <svg class="bg-obj bg-obj-2" viewBox="0 0 160 130" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.1">
        <path d="M80 30C80 30 60 25 30 25V105C60 105 80 110 80 110" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M80 30C80 30 100 25 130 25V105C100 105 80 110 80 110" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M45 45H65" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
        <path d="M45 55H60" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
        <path d="M45 65H63" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
        <path d="M95 45H115" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
        <path d="M95 55H110" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
        <line x1="80" y1="25" x2="80" y2="110" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
      </g>
    </svg>
    <svg class="bg-obj bg-obj-3" viewBox="0 0 140 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.1">
        <rect x="10" y="15" width="120" height="75" rx="6" stroke="currentColor" stroke-width="2.5"/>
        <path d="M10 15L70 60L130 15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </g>
    </svg>
    <svg class="bg-obj bg-obj-4" viewBox="0 0 110 140" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.1">
        <rect x="25" y="10" width="80" height="120" rx="4" stroke="currentColor" stroke-width="2.5"/>
        <line x1="25" y1="10" x2="25" y2="130" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        <circle cx="25" cy="25" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <circle cx="25" cy="40" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <circle cx="25" cy="55" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <circle cx="25" cy="70" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <circle cx="25" cy="85" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <circle cx="25" cy="100" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <circle cx="25" cy="115" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <path d="M40 35H90" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
        <path d="M40 50H85" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
        <path d="M40 65H88" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
      </g>
    </svg>
    <svg class="bg-obj bg-obj-5" viewBox="0 0 80 140" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.12">
        <path d="M15 10H65V120L40 100L15 120V10Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
      </g>
    </svg>
    <svg class="bg-obj bg-obj-6" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.1">
        <path d="M25 40H85V95C85 105 75 110 55 110C35 110 25 105 25 95V40Z" stroke="currentColor" stroke-width="2.5"/>
        <path d="M85 55H100C108 55 112 62 112 70C112 78 108 85 100 85H85" stroke="currentColor" stroke-width="2.5"/>
        <path d="M42 25C42 25 45 15 50 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
        <path d="M55 20C55 20 58 10 63 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
      </g>
    </svg>
    <svg class="bg-obj bg-obj-7" viewBox="0 0 60 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.1">
        <path d="M20 15H40V125L30 145L20 125V15Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
        <line x1="20" y1="30" x2="40" y2="30" stroke="currentColor" stroke-width="2"/>
        <line x1="20" y1="110" x2="40" y2="110" stroke="currentColor" stroke-width="2"/>
      </g>
    </svg>
    <svg class="bg-obj bg-obj-10" viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g opacity="0.08">
        <path d="M10 50C10 30 25 15 40 15V25C30 25 20 35 20 50H30V70H10V50Z" fill="currentColor"/>
        <path d="M60 50C60 30 75 15 90 15V25C80 25 70 35 70 50H80V70H60V50Z" fill="currentColor"/>
      </g>
    </svg>
  </div>

  <div class="relative z-10 pt-28 pb-20 px-6 md:px-12 lg:px-16">
    <div class="max-w-6xl mx-auto">

      {/* === HERO HEADER === */}
      <header class="mb-20" id="hero-header">
        <div class="overflow-hidden mb-4">
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-display italic text-warm-800 dark:text-warm-100 tracking-tight hero-title">
            文章
          </h1>
        </div>
        <div class="flex items-center gap-4 mb-6">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono tracking-wider bg-warm-100/80 dark:bg-warm-800/50 text-warm-500 dark:text-warm-400 backdrop-blur-sm border border-warm-200/40 dark:border-warm-700/40 hero-count">
            <NumberTicker value={postCount} client:load className="text-warm-500 dark:text-warm-400" /> 篇文章
          </span>
          <div class="flex-1 h-px bg-gradient-to-r from-warm-300/50 dark:from-warm-600 to-transparent hero-line" />
        </div>
        <p class="text-base md:text-lg text-warm-400 dark:text-warm-500 max-w-xl leading-relaxed hero-subtitle">
          记录技术、生活与思考。<br class="hidden md:block" />在这里分享我对代码和世界的理解。
        </p>
      </header>

      {/* === FEATURED POST — HERO CARD === */}
      {featured && (
        <section class="mb-16" id="featured-section">
          <BlurFade client:visible delay={0} duration={0.5} direction="left" offset={20}>
            <div class="flex items-center gap-3 mb-6">
              <span class="text-[10px] font-mono tracking-[0.2em] uppercase text-warm-300 dark:text-warm-600">最新发布</span>
              <div class="flex-1 h-px bg-warm-200/40 dark:bg-warm-700/40" />
            </div>
          </BlurFade>
          <BlurFade client:load delay={0.2} duration={0.6} offset={10}>
          <a href={`${base}/blog/${featured.slug}`} class="group block">
            <div class="relative overflow-hidden rounded-3xl bg-white/15 dark:bg-white/[0.04] backdrop-blur-xl border border-white/30 dark:border-white/[0.08] shadow-[0_4px_30px_rgba(0,0,0,0.06)] dark:shadow-[0_4px_30px_rgba(0,0,0,0.25)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] dark:hover:shadow-[0_20px_60px_rgba(0,0,0,0.4)] transition-all duration-700 hover:border-white/50 dark:hover:border-white/[0.15]"
              style="backdrop-filter: blur(40px) saturate(2) brightness(1.05); -webkit-backdrop-filter: blur(40px) saturate(2) brightness(1.05);">

              {/* Hover glow */}
              <div class="absolute inset-0 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
                style="background: radial-gradient(ellipse at 30% 50%, rgba(255,255,255,0.06) 0%, transparent 70%);" />

              <div class="grid grid-cols-1 md:grid-cols-5 gap-0">
                {/* Image area */}
                <div class="md:col-span-3 relative h-64 md:h-[400px] bg-gradient-to-br from-rose-100 via-orange-50 to-amber-100 dark:from-rose-900/30 dark:via-orange-900/20 dark:to-amber-900/20 overflow-hidden">
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="relative">
                      <div class="w-32 h-32 rounded-3xl bg-white/25 dark:bg-white/[0.06] rotate-12 group-hover:rotate-6 transition-transform duration-1000 animate-float" />
                      <div class="absolute -top-5 -right-8 w-20 h-20 rounded-2xl bg-white/20 dark:bg-white/[0.05] -rotate-6 group-hover:rotate-0 transition-transform duration-1000 animate-float" style="animation-delay: 0.5s" />
                      <div class="absolute -bottom-6 -left-5 w-14 h-14 rounded-full bg-white/15 dark:bg-white/[0.04] group-hover:scale-110 transition-transform duration-1000 animate-float" style="animation-delay: 1s" />
                    </div>
                  </div>
                  {/* Shimmer */}
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-out" />
                  <div class="absolute top-5 left-5">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-medium tracking-wider bg-warm-800 text-warm-100 dark:bg-white dark:text-black">{featured.data.category}</span>
                  </div>
                </div>

                {/* Content */}
                <div class="md:col-span-2 p-8 md:p-10 lg:p-12 flex flex-col justify-center">
                  <div class="flex items-center gap-2.5 mb-6">
                    <span class="text-[10px] text-warm-400 font-mono tracking-wider">{formatDate(featured.data.date)}</span>
                    {featured.data.tags && featured.data.tags.length > 0 && (
                      <>
                        <span class="text-warm-200 dark:text-warm-700">·</span>
                        <div class="flex items-center gap-1.5">
                          {featured.data.tags.slice(0, 2).map((tag: string) => (
                            <span class="text-[9px] font-mono tracking-wider text-warm-300 dark:text-warm-600">#{tag}</span>
                          ))}
                        </div>
                      </>
                    )}
                  </div>

                  <h2 class="text-2xl md:text-3xl lg:text-4xl font-display italic text-warm-800 dark:text-warm-100 tracking-tight leading-tight mb-5 group-hover:text-black dark:group-hover:text-white transition-colors duration-500">
                    {featured.data.title}
                  </h2>

                  <p class="text-sm md:text-base text-warm-500 dark:text-warm-400 leading-relaxed mb-10 line-clamp-3">
                    {featured.data.description}
                  </p>

                  <span class="inline-flex items-center gap-2.5 text-xs text-warm-400 dark:text-warm-500 group-hover:text-warm-700 dark:group-hover:text-warm-200 transition-all duration-500 font-mono tracking-wider mt-auto">
                    阅读全文
                    <svg class="w-4 h-4 group-hover:translate-x-2 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </div>
          </a>
          </BlurFade>
        </section>
      )}

      {/* === CATEGORY FILTER === */}
      <div class="mb-12">
        <BlurFade client:visible delay={0} duration={0.5} direction="left" offset={20}>
          <CategoryFilter client:load onFilterChange={() => {}} />
        </BlurFade>
      </div>

      {/* === POST GRID === */}
      {rest.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {rest.map((post, i) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              slug={post.slug}
              tags={post.data.tags}
              index={i + 1}
              large
              client:load
            />
          ))}
        </div>
      )}

      {/* Empty state */}
      {posts.length === 0 && (
        <div class="text-center py-24">
          <div class="w-20 h-20 mx-auto mb-8 rounded-3xl bg-white/40 backdrop-blur-xl border border-white/60 flex items-center justify-center text-3xl shadow-sm"
            style="backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);">✍️</div>
          <p class="text-lg font-display italic text-warm-400 dark:text-warm-500 mb-2">还没有文章</p>
          <p class="text-sm text-warm-300 dark:text-warm-600">期待第一篇创作</p>
        </div>
      )}

    </div>
  </div>

  <style>
    /* Background writing objects */
    .bg-objects {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
      color: #94a3b8;
    }
    .dark .bg-objects {
      color: #4a5568;
    }
    .bg-obj {
      position: absolute;
      will-change: transform;
      transition: transform 0.1s linear;
    }
    .bg-obj-1 { width: 140px; top: 8%; right: 8%; }
    .bg-obj-2 { width: 180px; top: 35%; left: 3%; }
    .bg-obj-3 { width: 130px; top: 65%; right: 5%; }
    .bg-obj-4 { width: 120px; top: 5%; left: 10%; }
    .bg-obj-5 { width: 70px; top: 50%; right: 15%; }
    .bg-obj-6 { width: 110px; bottom: 10%; left: 8%; }
    .bg-obj-7 { width: 50px; top: 25%; right: 25%; }
    .bg-obj-10 { width: 130px; top: 18%; left: 45%; }

    /* Hero animations */
    .hero-title {
      opacity: 0;
      transform: translateY(40px);
      animation: heroReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
    }
    .hero-count {
      opacity: 0;
      transform: translateY(20px);
      animation: heroReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }
    .hero-line {
      opacity: 0;
      transform: scaleX(0);
      transform-origin: left;
      animation: lineExtend 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
    }
    .hero-subtitle {
      opacity: 0;
      transform: translateY(20px);
      animation: heroReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
    }

    @keyframes heroReveal {
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes lineExtend {
      to { opacity: 1; transform: scaleX(1); }
    }
  </style>

  {/* Parallax background objects */}
  <script is:inline>
    document.addEventListener('astro:page-load', function() {
      var objs = document.querySelectorAll('.bg-obj');
      var speeds = [0.03, 0.05, 0.02, 0.04, 0.06, 0.035, 0.045, 0.025];
      var ticking = false;
      window.addEventListener('scroll', function() {
        if (!ticking) {
          requestAnimationFrame(function() {
            var scrollY = window.scrollY;
            objs.forEach(function(obj, i) {
              var speed = speeds[i % speeds.length];
              var y = scrollY * speed;
              var rotate = Math.sin(scrollY * 0.002 + i) * 5;
              obj.style.transform = 'translateY(' + (-y) + 'px) rotate(' + rotate + 'deg)';
            });
            ticking = false;
          });
          ticking = true;
        }
      });
    });
  </script>
</BaseLayout>
