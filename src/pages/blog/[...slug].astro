---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/blog/TableOfContents';
import Badge from '../../components/ui/Badge';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={`${post.data.title} — Lucid 清醒`}>
  <article class="pt-28 pb-16 px-6 md:px-12 lg:px-24">
    <div class="max-w-4xl mx-auto">
      {/* Header */}
      <header class="mb-14">
        <div class="flex items-center gap-3 mb-5">
          <span class="text-[10px] text-warm-500/25 font-mono tracking-wider">{formatDate(post.data.date)}</span>
          <Badge variant="primary">{post.data.category}</Badge>
        </div>
        <h1 class="text-3xl md:text-5xl font-display italic tracking-tight text-warm-50 leading-tight">{post.data.title}</h1>
        <p class="text-sm text-warm-400/40 mt-4 max-w-2xl">{post.data.description}</p>
      </header>

      {/* Divider */}
      <div class="dramatic-divider mb-12"></div>

      <div class="flex gap-16">
        {/* TOC - sidebar on large screens */}
        <aside class="hidden lg:block w-56 flex-shrink-0">
          <div class="sticky top-28">
            <TableOfContents headings={headings} client:idle />
          </div>
        </aside>

        {/* Content */}
        <div class="flex-1 min-w-0 prose prose-warm max-w-none
          prose-headings:font-display prose-headings:italic prose-headings:tracking-tight
          prose-headings:scroll-mt-28
          prose-a:text-primary hover:prose-a:text-primary-light prose-a:transition-colors prose-a:no-underline hover:prose-a:underline
          prose-code:text-primary/80 prose-code:bg-white/[0.04] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-xs
          prose-pre:bg-surface prose-pre:border prose-pre:border-white/[0.06] prose-pre:rounded-xl
          prose-img:rounded-xl
          prose-blockquote:border-primary/25 prose-blockquote:text-warm-300/50 prose-blockquote:not-italic prose-blockquote:font-display
          prose-strong:text-warm-200/80
          prose-p:text-warm-300/55 prose-p:leading-[1.8]
          prose-li:text-warm-300/55
          prose-h2:text-warm-100/90 prose-h3:text-warm-200/70
        ">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
