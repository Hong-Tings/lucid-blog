---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/blog/TableOfContents';
import Badge from '../../components/ui/Badge';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={`${post.data.title} — Lucid 清醒`}>
  <article class="pt-28 pb-16 px-6 md:px-12 lg:px-24">
    <div class="max-w-4xl mx-auto">
      {/* Header */}
      <header class="mb-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-[10px] text-white/25 font-mono tracking-wider">{formatDate(post.data.date)}</span>
          <Badge variant="primary">{post.data.category}</Badge>
        </div>
        <h1 class="text-3xl md:text-4xl font-display font-bold tracking-tight">{post.data.title}</h1>
        <p class="text-sm text-white/40 mt-3">{post.data.description}</p>
      </header>

      <div class="flex gap-16">
        {/* TOC - sidebar on large screens */}
        <aside class="hidden lg:block w-56 flex-shrink-0">
          <div class="sticky top-28">
            <TableOfContents headings={headings} client:idle />
          </div>
        </aside>

        {/* Content */}
        <div class="flex-1 min-w-0 prose prose-invert prose-sm max-w-none
          prose-headings:font-display prose-headings:tracking-tight
          prose-headings:scroll-mt-28
          prose-a:text-primary hover:prose-a:text-accent prose-a:transition-colors
          prose-code:text-accent prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-xs
          prose-pre:bg-surface prose-pre:border prose-pre:border-white/[0.06] prose-pre:rounded-xl
          prose-img:rounded-xl
          prose-blockquote:border-primary/30 prose-blockquote:text-white/50 prose-blockquote:not-italic
          prose-strong:text-white/80
          prose-p:text-white/60 prose-p:leading-relaxed
          prose-li:text-white/60
          prose-h2:text-white/90 prose-h3:text-white/80
        ">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
