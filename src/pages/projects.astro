---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/sections/ProjectCard';

const projects = [
  { icon: '🚀', name: 'Cool CLI Tool', description: '一个让终端更好用的命令行工具', stars: 1200, language: 'TypeScript', url: '#' },
  { icon: '🎨', name: 'Color Palette', description: 'AI 驱动的配色方案生成器', stars: 856, language: 'React', url: '#' },
  { icon: '📦', name: 'Mini ORM', description: '轻量级数据库 ORM', stars: 432, language: 'Go', url: '#' },
  { icon: '🤖', name: 'Chat Bot', description: '智能对话机器人框架', stars: 2100, language: 'Python', url: '#' },
];
---

<BaseLayout title="项目 — Lucid">
  <div class="pt-28 pb-16 px-6 md:px-12 lg:px-24 relative overflow-hidden">
    {/* Background glows */}
    <div class="absolute top-1/3 left-0 w-[350px] h-[350px] bg-black/[0.02] dark:bg-white/[0.02] rounded-full blur-[100px]" aria-hidden="true" />
    <div class="absolute bottom-1/4 right-0 w-[250px] h-[250px] bg-black/[0.015] dark:bg-white/[0.015] rounded-full blur-[80px]" aria-hidden="true" />
    {/* Grid of dots pattern */}
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 32px 32px;" aria-hidden="true" />
    {/* Corner accent */}
    <div class="absolute top-16 right-8 w-24 h-24 border border-warm-200 dark:border-warm-700 rounded-full" aria-hidden="true" />
    <div class="absolute top-20 right-12 w-16 h-16 border border-warm-100 dark:border-warm-800 rounded-full" aria-hidden="true" />

    <div class="max-w-5xl mx-auto relative">
      <div class="flex items-center gap-4 mb-3">
        <h1 class="text-2xl font-display italic text-warm-800 dark:text-warm-200 tracking-tight glitch-hover" data-text="项目">项目</h1>
        <div class="flex-1 h-px bg-gradient-to-r from-primary/20 dark:from-white/20 to-transparent"></div>
      </div>
      <p class="text-xs text-warm-400 dark:text-warm-500 mb-10 tracking-wider font-mono">开源项目和个人作品</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
