---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/sections/GalleryGrid';
---

<BaseLayout title="摄影 — Lucid 清醒">
  <div class="pt-28 pb-16 px-6 md:px-12 lg:px-24">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-2xl font-display font-bold mb-2 gradient-text tracking-tight">摄影</h1>
      <p class="text-xs text-white/30 mb-10 tracking-wider">用镜头记录世界的瞬间</p>
      <GalleryGrid client:visible />
    </div>
  </div>
</BaseLayout>
