---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/sections/GalleryGrid';
---

<BaseLayout title="摄影 — Lucid">
  <div class="pt-28 pb-16 px-6 md:px-12 lg:px-24 relative overflow-hidden">
    {/* Background glow */}
    <div class="absolute top-1/2 right-0 w-[400px] h-[400px] bg-black/[0.02] dark:bg-white/[0.02] rounded-full blur-[100px]" aria-hidden="true" />
    {/* Oversized decorative text */}
    <div class="absolute -right-8 top-8 text-[220px] font-display italic text-warm-100 dark:text-warm-800/20 leading-none select-none pointer-events-none" aria-hidden="true">G</div>
    {/* Horizontal accent lines */}
    <div class="absolute top-40 left-0 w-full h-px bg-gradient-to-r from-transparent via-warm-200 dark:via-warm-700 to-transparent" aria-hidden="true" />
    <div class="absolute bottom-32 left-0 w-full h-px bg-gradient-to-r from-transparent via-warm-100 dark:via-warm-800 to-transparent" aria-hidden="true" />

    <div class="max-w-5xl mx-auto relative">
      <div class="flex items-center gap-4 mb-3">
        <h1 class="text-2xl font-display italic text-warm-800 dark:text-warm-200 tracking-tight glitch-hover" data-text="摄影">摄影</h1>
        <div class="flex-1 h-px bg-gradient-to-r from-primary/20 dark:from-white/20 to-transparent"></div>
      </div>
      <p class="text-xs text-warm-400 dark:text-warm-500 mb-10 tracking-wider font-mono">用镜头记录世界的瞬间</p>
      <GalleryGrid client:visible />
    </div>
  </div>
</BaseLayout>
