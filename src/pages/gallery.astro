---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/sections/GalleryGrid';
---

<BaseLayout title="摄影 — Lucid 清醒">
  <div class="pt-28 pb-16 px-6 md:px-12 lg:px-24">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-4 mb-3">
        <h1 class="text-2xl font-display italic text-warm-50 tracking-tight">摄影</h1>
        <div class="flex-1 h-px bg-gradient-to-r from-primary/20 to-transparent"></div>
      </div>
      <p class="text-xs text-warm-500/30 mb-10 tracking-wider font-mono">用镜头记录世界的瞬间</p>
      <GalleryGrid client:visible />
    </div>
  </div>
</BaseLayout>
