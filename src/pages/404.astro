---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBackground from '../components/effects/PageBackground.astro';
---

<BaseLayout title="404 — Lucid">
  <PageBackground theme="pulse" />
  <div class="min-h-screen flex items-center justify-center relative overflow-hidden">
    {/* Oversized 404 */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[280px] md:text-[400px] font-display italic text-warm-100 dark:text-warm-800/20 leading-none select-none pointer-events-none" aria-hidden="true">404</div>

    <div class="relative z-10 text-center px-6">
      <p class="text-[10px] tracking-[0.6em] uppercase text-warm-400 dark:text-warm-500 mb-6 font-mono">Page Not Found</p>
      <h1 class="text-4xl md:text-6xl font-display italic text-warm-800 dark:text-warm-200 tracking-tight mb-6">迷路了</h1>
      <p class="text-sm text-warm-500 dark:text-warm-400 leading-[1.9] max-w-md mx-auto mb-10">
        你要找的页面似乎不存在，也许它去了另一个维度。
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href={import.meta.env.BASE_URL} class="btn-ripple px-6 py-2.5 bg-black dark:bg-white text-white dark:text-black text-xs font-semibold rounded-lg transition-all duration-300 hover:bg-warm-700 dark:hover:bg-warm-200 active:scale-[0.97]">
          回到首页
        </a>
        <a href={`${import.meta.env.BASE_URL}blog`} class="glass-card px-6 py-2.5 text-xs font-mono tracking-wider uppercase text-warm-600 dark:text-warm-300 hover:text-black dark:hover:text-white hover:border-warm-400 dark:hover:border-warm-500 transition-all duration-300">
          看看文章
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
