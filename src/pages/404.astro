---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Lucid">
  <div class="min-h-screen flex items-center justify-center relative overflow-hidden">
    {/* Background glows */}
    <div class="absolute top-1/3 left-1/4 w-[300px] h-[300px] bg-black/[0.02] dark:bg-white/[0.02] rounded-full blur-[100px]" aria-hidden="true" />
    <div class="absolute bottom-1/3 right-1/4 w-[250px] h-[250px] bg-black/[0.015] dark:bg-white/[0.015] rounded-full blur-[80px]" aria-hidden="true" />
    {/* Grid pattern */}
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 48px 48px;" aria-hidden="true" />
    {/* Oversized 404 */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[280px] md:text-[400px] font-display italic text-warm-100 dark:text-warm-800/20 leading-none select-none pointer-events-none" aria-hidden="true">404</div>

    <div class="relative z-10 text-center px-6">
      <p class="text-[10px] tracking-[0.6em] uppercase text-warm-400 dark:text-warm-500 mb-6 font-mono">Page Not Found</p>
      <h1 class="text-4xl md:text-6xl font-display italic text-warm-800 dark:text-warm-200 tracking-tight mb-6">迷路了</h1>
      <p class="text-sm text-warm-500 dark:text-warm-400 leading-[1.9] max-w-md mx-auto mb-10">
        你要找的页面似乎不存在，也许它去了另一个维度。
      </p>
      <div class="flex items-center justify-center gap-4">
        <a href="/" class="btn-ripple px-6 py-2.5 bg-black dark:bg-white text-white dark:text-black text-xs font-semibold rounded-lg transition-all duration-300 hover:bg-warm-700 dark:hover:bg-warm-200 active:scale-[0.97]">
          回到首页
        </a>
        <a href="/blog" class="glass-card px-6 py-2.5 text-xs font-mono tracking-wider uppercase text-warm-600 dark:text-warm-300 hover:text-black dark:hover:text-white hover:border-warm-400 dark:hover:border-warm-500 transition-all duration-300">
          看看文章
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
