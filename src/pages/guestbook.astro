---
import BaseLayout from '../layouts/BaseLayout.astro';

const messages = [
  { name: '小明', avatar: 'from-amber-500 to-orange-500', time: '2 小时前', text: '博客设计得太酷了！学到了很多 ✨' },
  { name: 'Alice', avatar: 'from-emerald-500 to-teal-500', time: '昨天', text: '文章写得很棒，期待更多内容！' },
  { name: 'Bob', avatar: 'from-rose-500 to-red-500', time: '3 天前', text: '从友链过来的，已收藏 👍' },
];
---

<BaseLayout title="留言 — Lucid 清醒">
  <div class="pt-28 pb-16 px-6 md:px-12 lg:px-24">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center gap-4 mb-3">
        <h1 class="text-2xl font-display italic text-warm-50 tracking-tight">留言板</h1>
        <div class="flex-1 h-px bg-gradient-to-r from-primary/20 to-transparent"></div>
      </div>
      <p class="text-xs text-warm-500/30 mb-10 tracking-wider font-mono">留下你的足迹</p>

      {/* Input area */}
      <div class="glass-card p-5 mb-10">
        <textarea
          class="w-full bg-transparent text-warm-200/60 text-sm placeholder:text-warm-500/20 outline-none resize-none min-h-[80px] leading-relaxed"
          placeholder="写下你想说的..."
        ></textarea>
        <div class="flex justify-end mt-4">
          <button class="px-6 py-2.5 bg-primary hover:bg-primary-light text-surface-dark text-xs font-semibold rounded-lg transition-colors duration-300">
            发送
          </button>
        </div>
      </div>

      {/* Messages */}
      <div class="space-y-6">
        {messages.map((msg) => (
          <div class="flex gap-3">
            <div class={`w-8 h-8 rounded-full bg-gradient-to-br ${msg.avatar} flex-shrink-0`} />
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-medium text-warm-200/60">{msg.name}</span>
                <span class="text-[10px] text-warm-500/20">{msg.time}</span>
              </div>
              <p class="text-xs text-warm-400/40 leading-relaxed">{msg.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
