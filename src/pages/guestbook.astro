---
import BaseLayout from '../layouts/BaseLayout.astro';

const messages = [
  { name: '小明', avatar: 'from-pink-500 to-rose-500', time: '2 小时前', text: '博客设计得太酷了！学到了很多 ✨' },
  { name: 'Alice', avatar: 'from-emerald-500 to-green-500', time: '昨天', text: '文章写得很棒，期待更多内容！' },
  { name: 'Bob', avatar: 'from-blue-500 to-sky-500', time: '3 天前', text: '从友链过来的，已收藏 👍' },
];
---

<BaseLayout title="留言 — Lucid 清醒">
  <div class="pt-28 pb-16 px-6 md:px-12 lg:px-24">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-2xl font-display font-bold mb-2 gradient-text tracking-tight">留言板</h1>
      <p class="text-xs text-white/30 mb-10 tracking-wider">留下你的足迹</p>

      {/* Input area */}
      <div class="glass-card p-5 mb-10">
        <textarea
          class="w-full bg-transparent text-white/70 text-sm placeholder:text-white/20 outline-none resize-none min-h-[80px] leading-relaxed"
          placeholder="写下你想说的..."
        ></textarea>
        <div class="flex justify-end mt-4">
          <button class="px-6 py-2 bg-primary hover:bg-primary-light rounded-lg text-xs font-medium transition-colors duration-300">
            发送
          </button>
        </div>
      </div>

      {/* Messages */}
      <div class="space-y-6">
        {messages.map((msg) => (
          <div class="flex gap-3">
            <div class={`w-8 h-8 rounded-full bg-gradient-to-br ${msg.avatar} flex-shrink-0`} />
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-medium text-white/70">{msg.name}</span>
                <span class="text-[10px] text-white/20">{msg.time}</span>
              </div>
              <p class="text-xs text-white/40 leading-relaxed">{msg.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
